{
  "[dart]": {
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.formatOnPaste": false
  },
  "html.format.enable": false,
  "githubPullRequests.ignoredPullRequestBranches": [
    "master"
  ],
  "files.trimTrailingWhitespace": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll": "explicit"
  },
  "dart.analyzeAngularTemplates": false,
  "dart.documentation": "full",
  "dart.enableCompletionCommitCharacters": true,
  "dart.renameFilesWithClasses": "prompt",
  "dart.allowTestsOutsideTestFolder": true,
  "dart.autoImportCompletions": true,
  "dart.flutterSdkPath": ".fvm/versions/master",
  "dart.flutterTestAdditionalArgs": [
    "--platform=chrome",
    "--web-renderer=html"
  ],
  "search.exclude": {
    "**/.fvm": true
  },
  "files.watcherExclude": {
    "**/.fvm": true
  }
}